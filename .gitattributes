*.pdf binary
*.doc binary
*.docx binary
*.png binary
*.tar.gz binary
*.zip binary
# Preserve upstream text extraction and author README bytes for checksum provenance.
benchmarks/papers/**/*.txt -whitespace
benchmarks/papers/**/*.html -whitespace
research/papers/**/*.txt -whitespace
research/reading/**/*.txt -whitespace
research/reading/**/*.html -whitespace
benchmarks/dataset-notes/*README.md -whitespace
# Imported competition drafts retain their exact archived bytes and hashes.
competition/deliverables/**/*.md -whitespace
competition/review/*.md -whitespace
competition/figureforge-texts/*.md -whitespace

# Keep frontend formatter input identical on Windows and Linux.
system/frontend/**/*.ts text eol=lf
system/frontend/**/*.tsx text eol=lf
system/frontend/**/*.js text eol=lf
system/frontend/**/*.mjs text eol=lf
system/frontend/**/*.css text eol=lf
system/frontend/**/*.json text eol=lf
system/frontend/**/*.html text eol=lf
