# Generate actual local credentials with: python3 scripts/init_local.py
PROJECT_NAME=AI Code Audit
FASTAPI_ENV=development
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://audit:YOUR_PASSWORD@127.0.0.1:15440/audit
FRONTEND_HOST=http://127.0.0.1:5174
REDIS_URL=redis://127.0.0.1:16380/0
CODEQL_BIN=codeql
CODEQL_PYTHON_BIN=python3.11
PYTHON_QUERY_PACK=codeql/python-queries@1.6.0
JAVASCRIPT_QUERY_PACK=codeql/javascript-queries@1.4.0
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=90
AI_MAX_OUTPUT_TOKENS=6000
# 0 inherits the global output budget
AI_REVIEW_TOKENS=0
AI_SCOUT_TOKENS=3000
AI_REPAIR_TOKENS=0
AI_RULE_TOKENS=6000
AI_STAGE_MAX_CALLS=24
AI_STAGE_MAX_TOKENS=100000
AI_STAGE_MAX_SECONDS=300
# New scout/review/repair stages continue while bounded workflow progress is made.
# bounded restores the three hard stage limits above; old stages keep snapshots.
AI_AUDIT_EXECUTION_MODE=progress
AI_STAGE_MAX_NO_PROGRESS=3
# Optional; omit unless this provider supports it: enabled or disabled
AI_THINKING_MODE=disabled
# Optional: same gateway must support /embeddings
EMBEDDING_MODEL=
EMBEDDING_REVISION=
EMBEDDING_DIMENSIONS=0
# Preferred payload size. Repair3 may expand only for actual source, within
# this frozen ceiling; navigation/facts are never silently truncated.
SEMANTIC_CONTEXT_CHARS=40000
SEMANTIC_REPAIR_MAX_CONTEXT_CHARS=80000
SEMANTIC_TOOL_LIMIT=8
REPAIR_ATTEMPTS=3
VALIDATOR_PYTHON_IMAGE=ai-code-audit-validator:local
VALIDATOR_JS_IMAGE=node:22-bookworm-slim
VALIDATOR_TIMEOUT=120

UI_DB_PORT=15440
UI_REDIS_PORT=16380
