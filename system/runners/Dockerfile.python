ARG PYTHON_IMAGE=python:3.11-slim@sha256:da047cb8f9d1d98e5c070f5300ba9f7274e33b8fc0e5be5ed88740aed1b95ba9
FROM ${PYTHON_IMAGE}
RUN pip install --no-cache-dir pytest==8.3.5 pluggy==1.6.0 iniconfig==2.3.0 packaging==26.3
COPY requirements-flask.txt /tmp/requirements-flask.txt
RUN pip install --no-cache-dir -r /tmp/requirements-flask.txt && rm /tmp/requirements-flask.txt
USER 65534:65534
WORKDIR /workspace
