# Copy to repository root as .env.docker. No real credentials are included.
POSTGRES_PASSWORD=
APP_PORT=5181
# Set registry-1.docker.io to use the official registry directly if a local mirror fails.
IMAGE_REGISTRY=docker.io
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=
AI_THINKING_MODE=disabled
AI_AUDIT_EXECUTION_MODE=progress
AI_TIMEOUT=90
